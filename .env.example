# Copy to .env.local for local development. In production use Railway Variables.
# Set these on BOTH the web and worker services. No secrets go into GitHub.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=txdot-originals
# Required on the web service. Keeping the same shared variables on both is OK.
SUPABASE_PUBLISHABLE_KEY=
STUDIO_ALLOWED_EMAILS=
APP_URL=http://localhost:3000
# Optional AI. Set BOTH together on web and worker to enable assistance.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional cover generation override on the worker. Defaults to gpt-image-2.
# Uses the same server-side OPENAI_API_KEY. Included cover needs no image API call.
OPENAI_IMAGE_MODEL=gpt-image-2
# Optional tuning. Use at least 2; the worker has a separate heartbeat connection.
DB_POOL_MAX=5
# Optional PEM root certificate from Supabase, if not already publicly trusted.
# Newlines may be literal newlines or escaped \n. TLS verification remains enabled.
DATABASE_CA_CERT=
